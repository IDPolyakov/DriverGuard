        {
            "name": "release",
            "displayName": "Windows MSVC x64 - Release",
            "description": "Configure DriverGuard for Visual Studio 2022 and vcpkg",
            "inherits": "windows-msvc-base"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Build Debug",
            "configurePreset": "debug",
            "configuration": "Debug"
